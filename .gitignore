# Swift Package Manager
.build/
.swiftpm/
*.xcodeproj
*.xcworkspace
# A consumer package under examples/ resolves the same dependency graph as the
# root, so it follows the tree rather than pinning a second resolution: a
# committed fixture lockfile would go stale and test a combination nobody ships.
examples/*/Package.resolved

# Xcode
DerivedData/
xcuserdata/
*.xcuserstate
*.xcscheme

# macOS
.DS_Store

# Build artifacts
*.o
*.a
*.dylib
*.metallib

# Model weights / large blobs
*.safetensors
*.gguf
*.bin
*.npz
*.pdf
weights/
models/
# Repacked model directories (manifest.json/layout.json inside aren't caught by *.bin).
# `.ssdai` is the name since 5.15; `.gturbo` installs built before that are still ignored.
*.ssdai/
*.gturbo/

# Editor
.vscode/
.idea/
*.swp
*~

# Logs / scratch
*.log
benchmark-results/
scratch/
tmp/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

.qwen/

# Node (plugins/dsh-tinytitan)
node_modules/

# Standalone release binaries
Binary/

# 72-combo harness mock (test scaffolding)
benchmark/mock/
# Persistent agent memory: one journal per project, user data, never committed.
memory/
models/gguf/

# Agent scratch (worktrees, caches); keep git status clean
.claude/

# Audit run artifacts. Findings belong in the wiki tracker/archive, not in the
# repository: a committed ledger goes stale the moment the tree moves on.
/AUDIT/
*.sarif
